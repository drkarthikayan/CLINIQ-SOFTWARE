rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Super admin = the superadmin custom claim OR the single owner email, so
    // the owner account works even when created straight from the Firebase
    // console (no Admin-SDK claim script). Keep this email in sync with
    // SUPERADMIN_EMAIL in src/services/auth.service.js.
    function isSuperadmin() {
      return signedIn() && (request.auth.token.superadmin == true
        || request.auth.token.email == 'superadmin@cliniq.app');
    }
    function inTenant(tenantId) {
      return signedIn() && (request.auth.token.tenantId == tenantId || isSuperadmin());
    }
    function hasRole(tenantId, roles) {
      return inTenant(tenantId) && request.auth.token.role in roles;
    }

    // Public demo tenant: any signed-in user can read/write it (throwaway demo
    // data), so the demo account works with no custom claims. Union with the
    // generic /tenants rules below — access is granted if either allows.
    match /tenants/demo-clinic {
      allow read, write: if signedIn();
    }
    match /tenants/demo-clinic/{path=**} {
      allow read, write: if signedIn();
    }

    // Platform-level (SaaS) config + billing — superadmin only.
    match /platform/{docId} {
      allow read: if signedIn();
      allow write: if isSuperadmin();
    }
    match /platform_invoices/{invoiceId} {
      allow read, write: if isSuperadmin();
    }

    match /tenants/{tenantId} {
      allow read: if inTenant(tenantId);
      // Create/delete stay superadmin-only (seed script / Superadmin tool).
      // Admin & doctor may UPDATE their own tenant doc — clinic name/city and
      // the module toggles edited from the Settings page.
      allow create, delete: if isSuperadmin();
      allow update: if hasRole(tenantId, ['admin', 'doctor']) || isSuperadmin();

      match /staff/{staffId} {
        allow read: if inTenant(tenantId);
        allow write: if hasRole(tenantId, ['admin', 'doctor']);
      }
      match /patients/{patientId} {
        allow read, write: if inTenant(tenantId);
      }
      match /visits/{visitId} {
        allow read, write: if inTenant(tenantId);
      }
      match /appointments/{apptId} {
        allow read, write: if inTenant(tenantId);
      }
      match /invoices/{invoiceId} {
        allow read, write: if inTenant(tenantId);
      }
      match /dispensary/{recordId} {
        allow read, write: if inTenant(tenantId);
      }
      match /dispensary_log/{logId} {
        allow read, write: if inTenant(tenantId);
      }
      match /waste_register/{wasteId} {
        allow read, write: if inTenant(tenantId);
      }
      match /pharmacy_stock/{batchId} {
        allow read: if inTenant(tenantId);
        allow write: if hasRole(tenantId, ['admin', 'doctor', 'nurse']) || isSuperadmin();
      }
      match /templates/{templateId} {
        allow read: if inTenant(tenantId);
        allow write: if hasRole(tenantId, ['admin', 'doctor']) || isSuperadmin();
      }
      match /settings/{docId} {
        allow read: if inTenant(tenantId);
        allow write: if hasRole(tenantId, ['admin', 'doctor']) || isSuperadmin();
      }
    }
  }
}
